void setup() {
  Serial.begin(115200);

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }

  display.clearDisplay();
  display.display();
}

void loop() {
  // Loop through all 13 items (0 to 12)
  for (int i = 0; i < 9; i++) {
    display.clearDisplay();
    
    // Draw the current bitmap (Image is at i=0, lines are at i=1 to 12)
    display.drawBitmap(0, 0, bitmapArray[i], 128, 64, SSD1306_WHITE);
    
    display.display();
    
    // You can give a longer delay for the title image if you want (e.g., 4 seconds)
    if (i == 0) 
    {
      delay(8000); 
    }
    if (i == 1) 
    {
      delay(5000); 
    }
    if (i == 2) 
    {
      delay(6000); 
    }
    if (i == 3) 
    {
      delay(4000); 
    }
    if (i == 4) 
    {
      delay(3000); 
    }
    if (i == 5) 
    {
      delay(3000); 
    }
    if (i == 6) 
    {
      delay(3000); 
    }
    if (i == 7) 
    {
      delay(3000); 
    }
    else 
    {
      delay(3000); // 3 seconds for each lyric line
    }
  }
}